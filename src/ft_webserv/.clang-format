---
Language: Cpp
Standard: Cpp03          # no C++11+ constructs assumed while formatting

# --- Indentation ---
UseTab: Always
TabWidth: 4
IndentWidth: 4
ContinuationIndentWidth: 4
AccessModifierOffset: -4
NamespaceIndentation: None
IndentCaseLabels: false
IndentPPDirectives: None

# --- Braces (Allman: brace on its own line, like the current code) ---
BreakBeforeBraces: Allman

# --- Line length / breaking ---
ColumnLimit: 100
AlwaysBreakTemplateDeclarations: false
BinPackArguments: true
BinPackParameters: true
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never

# --- Spacing ---
SpaceBeforeParens: ControlStatements
SpaceAfterCStyleCast: false
SpacesInParentheses: false
SpacesInSquareBrackets: false
SpaceBeforeAssignmentOperators: true
PointerAlignment: Right      # int *ptr, not int* ptr

# --- Includes: don't reorder them (42-style headers rely on include order) ---
SortIncludes: false

# --- Misc ---
Cpp11BracedListStyle: false
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1
ReflowComments: false
